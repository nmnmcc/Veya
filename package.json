{
  "name": "veya",
  "description": "A programmable video creation library for TypeScript.",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.15.0",
  "workspaces": [
    "./packages/*"
  ],
  "scripts": {
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "format": "prettier --write .",
    "smoke": "tsx samples/00-basic-composite.ts && tsx samples/01-basic-sequence.ts && tsx samples/02-combinators.ts && tsx samples/03-anchors-and-timing.ts && tsx samples/04-guards-and-inputs.ts",
    "typecheck": "tsc -b --noEmit && yarn typecheck:types",
    "typecheck:types": "tsdown --no-exports --logLevel error && tsd --typings packages/core/dist/index.d.mts --files 'test-d/**/*.test-d.ts'"
  },
  "tsd": {
    "compilerOptions": {
      "module": "nodenext",
      "target": "esnext",
      "lib": [
        "esnext"
      ],
      "types": [
        "node"
      ],
      "baseUrl": ".",
      "paths": {
        "@veya/core": [
          "packages/core/dist/index.d.mts"
        ],
        "@veya/modifier": [
          "packages/modifier/dist/index.d.mts"
        ],
        "@veya/source-audio": [
          "packages/source-audio/dist/index.d.mts"
        ],
        "@veya/source-color": [
          "packages/source-color/dist/index.d.mts"
        ],
        "@veya/source-image": [
          "packages/source-image/dist/index.d.mts"
        ],
        "@veya/source-svg": [
          "packages/source-svg/dist/index.d.mts"
        ],
        "@veya/source-svg-resvg": [
          "packages/source-svg-resvg/dist/index.d.mts"
        ],
        "@veya/source-video": [
          "packages/source-video/dist/index.d.mts"
        ]
      },
      "strict": true,
      "noUnusedLocals": false,
      "noUnusedParameters": false
    }
  },
  "devDependencies": {
    "@effect/language-service": "latest",
    "@types/node": "24",
    "prettier": "^3.8.3",
    "tsd": "^0.33.0",
    "tsdown": "^0.22.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  }
}
