{
  "name": "@veya/source-image",
  "type": "module",
  "types": "./dist/index.d.mts",
  "dependencies": {
    "@veya/core": "workspace:*",
    "effect": "^4.0.0-beta.70"
  },
  "devDependencies": {
    "tsd": "^0.33.0"
  },
  "scripts": {
    "typecheck:types": "tsd"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./src/index.ts"
    }
  },
  "tsd": {
    "compilerOptions": {
